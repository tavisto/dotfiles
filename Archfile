# Arch/CachyOS package list — parallel to Brewfile for Linux installs
#
# Install all packages:
#   grep -v '^#' Archfile | grep -v '^$' | paru -S --needed -
#
# Install pacman-only (no AUR):
#   grep -v '^#' Archfile | grep -v '^$' | grep -v '# AUR' | sudo pacman -S --needed -

